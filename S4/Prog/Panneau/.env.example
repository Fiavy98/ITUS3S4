# Configuration MySQL pour Panneau Solaire
# Copier ce fichier en .env et adapter les valeurs

# Serveur MySQL
PANNEAU_DB_SERVER=localhost

# Port MySQL (défaut: 3306)
PANNEAU_DB_PORT=3306

# Nom de la base de données
PANNEAU_DB_NAME=PANNEAUDB

# Identifiants MySQL
PANNEAU_DB_USER=root
PANNEAU_DB_PASSWORD=

# Activation/désactivation de l'auto-save
PANNEAU_DB_AUTO_SAVE=1
